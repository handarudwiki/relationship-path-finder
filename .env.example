# Salin menjadi .env.local lalu isi OPENROUTER_API_KEY.
# Dipakai fitur Magic Recommendation, hanya di server (tidak pernah dikirim ke browser).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_SORT=throughput
